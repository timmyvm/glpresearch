# Database — SQLite file for local dev. Use a postgres:// URL in production (see prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used in emails and links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: send real emails through Resend (https://resend.com). Without it, emails are logged to the admin Email Log.
RESEND_API_KEY=""
EMAIL_FROM="GLP Research <orders@example.com>"

# Seed admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@glpresearch.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Shared secret for scheduled jobs. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`
# to /api/cron/expire-orders (hourly, see vercel.json), which cancels unpaid orders past the payment window.
CRON_SECRET=""
